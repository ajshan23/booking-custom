PORT=3080
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=customcalander
# Separate randomly generated secrets, at least 32 characters each.
SERVICE_API_KEY=
ADMIN_API_KEY=
# Exactly 32 random bytes encoded as base64. See README for generation command.
TOKEN_ENCRYPTION_KEY=
ORGANIZATION_ID=flowflex-internal
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3080/v1/google/callback
OPENAI_API_KEY=
# GPT-5.4 mini supports Structured Outputs. Requires access in your API project.
OPENAI_MODEL=gpt-5.4-mini
DEFAULT_TIMEZONE=Asia/Kolkata
WORKING_DAYS=1,2,3,4,5
WORK_START=09:00
WORK_END=18:00
SUPPORT_DURATION_MINUTES=30
ONBOARDING_DURATION_MINUTES=30
BUFFER_MINUTES=10
MIN_NOTICE_MINUTES=60
BOOKING_HORIZON_DAYS=60
SLOT_TTL_MINUTES=10
SESSION_TTL_HOURS=24
# Keep 0 when accessed directly; configure an exact trusted proxy hop count if needed.
TRUST_PROXY_HOPS=0
